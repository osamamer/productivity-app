# Copy this file to /opt/productivity-app/.env on the server.
# Never commit the copied file or reuse local-development credentials.

APP_DOMAIN=app.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=you@example.com

# GHCR image prefix without a tag. The GitHub workflow publishes
# ${IMAGE_PREFIX}-backend and ${IMAGE_PREFIX}-edge.
IMAGE_PREFIX=ghcr.io/your-github-owner/productivity-app
IMAGE_TAG=latest

POSTGRES_USER=productivity
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=productivity
KEYCLOAK_DB=keycloak

KEYCLOAK_REALM=productivity-app
KEYCLOAK_CLIENT_ID=productivity-app-frontend
KEYCLOAK_ADMIN_USER=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-different-long-random-value
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_PASSWORD_VERIFICATION_CLIENT_ID=admin-cli

TZ=UTC
