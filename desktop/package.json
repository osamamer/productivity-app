{
  "name": "claritard-desktop",
  "productName": "Claritard",
  "version": "1.2.0",
  "description": "Linux desktop app for Claritard with a private local database or the cloud.",
  "author": "Osama",
  "homepage": "https://github.com/osamamer/productivity-app",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "desktopName": "claritard.desktop",
  "scripts": {
    "build:resources": "./scripts/build-resources.sh",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "npm run build:resources && electron-builder --linux",
    "dist:only": "electron-builder --linux",
    "build:extension": "mkdir -p dist && rm -f dist/claritard-url-gate.xpi && cd firefox-extension && zip -q -r -X ../dist/claritard-url-gate.xpi ."
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.claritard.desktop",
    "productName": "Claritard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/node_modules/usocket/**"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "resources/frontend",
        "to": "frontend"
      },
      {
        "from": "resources/cloud-frontend",
        "to": "cloud-frontend"
      },
      {
        "from": "resources/jre",
        "to": "jre"
      },
      {
        "from": "firefox-extension",
        "to": "firefox-extension"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "assets/icon.png",
      "executableName": "claritard",
      "maintainer": "Osama",
      "synopsis": "Tasks, focus sessions, meditation and daily planning",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "osamamer",
        "repo": "productivity-app",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "dbus-next": "0.10.2",
    "electron-updater": "^6.8.11"
  }
}
