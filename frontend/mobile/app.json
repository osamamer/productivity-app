{
  "expo": {
    "name": "Claritard",
    "slug": "so-life",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/eye-care.png",
    "scheme": "solife",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/eye-care.png",
      "bundleIdentifier": "org.osama.solife"
    },
    "android": {
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F7F6FB",
        "foregroundImage": "./assets/images/eye-care.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "org.osama.solife"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/eye-care.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6FB",
          "image": "./assets/images/eye-care.png",
          "imageWidth": 128,
          "dark": {
            "backgroundColor": "#1E2124",
            "image": "./assets/images/eye-care.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-audio",
      "./plugins/withAndroidBuildPerformance",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": [],
          "disableFFmpeg": true,
          "disableStaticExternalLibs": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8a6d645-def2-4e79-993a-49e17e10be1b"
      }
    },
    "owner": "dngoo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c8a6d645-def2-4e79-993a-49e17e10be1b"
    }
  }
}
