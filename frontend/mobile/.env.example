# Android development uses adb reverse so these loopback URLs match Keycloak's
# local issuer. Production builds should use public HTTPS URLs instead.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:7070
EXPO_PUBLIC_KEYCLOAK_REALM=productivity-app
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=productivity-app-frontend
